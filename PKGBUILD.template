# Maintainer: automated (generated by scripts/update-pkgbuild.sh, do not hand-edit)
#
# Structure follows the real Arch linux/linux-mainline PKGBUILD conventions
# (pkgbase marker file, DEPMOD suppression, localversion/version files,
# image_name) with docs/BTF/rust/bpftool steps deliberately dropped -- this
# targets "build a working -ck kernel + headers", not full upstream parity.
pkgbase=linux-ck
pkgname=(linux-ck linux-ck-headers)
pkgver=${PKGVER}
pkgrel=1
pkgdesc='Linux kernel with Con Kolivas (-ck/MuQSS) scheduler and latency patches'
arch=(x86_64)
url='https://github.com/ckolivas/linux'
license=(GPL2)
makedepends=(bc kmod libelf pahole cpio perl tar xz)
options=(!strip)
_srcname=linux-${KVER}

source=(
  "${KERNEL_URL}"
  "ck.patch::${PATCH_URL}"
  'config'
)
sha256sums=(
  '${KERNEL_SHA256}'
  '${PATCH_SHA256}'
  'SKIP'
)

export KBUILD_BUILD_HOST=archlinux
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd "$_srcname"

  echo "Applying ck patch..."
  patch -Np1 < "$srcdir/ck.patch"

  echo "Setting version..."
  echo "-$pkgrel" > localversion.10-pkgrel
  echo "${pkgbase#linux}" > localversion.20-pkgname

  echo "Setting config..."
  cp "$srcdir/config" .config
  make olddefconfig
  diff -u "$srcdir/config" .config || :

  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version)"
}

build() {
  cd "$_srcname"
  make all
}

package_linux-ck() {
  pkgdesc="The $pkgdesc kernel and modules"
  depends=(coreutils initramfs kmod)
  optdepends=('linux-ck-headers: headers and scripts for building modules against linux-ck'
              'linux-firmware: firmware images needed for some devices')

  cd "$_srcname"
  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

  echo "Installing boot image..."
  install -Dm644 "$(make -s image_name)" "$modulesdir/vmlinuz"

  # Used by mkinitcpio to name the kernel/initramfs when multiple kernels are installed
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  echo "Installing modules..."
  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install  # Suppress depmod; kmod's pacman hook does the real one

  rm -f "$modulesdir"/build "$modulesdir"/source
}

package_linux-ck-headers() {
  pkgdesc="Headers and scripts for building modules against the $pkgdesc kernel"
  depends=(pahole)

  cd "$_srcname"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile

  cp -t "$builddir" -a scripts
  install -Dt "$builddir/include" -a include/*
  cp -t "$builddir/arch/x86" -a arch/x86/include

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}
